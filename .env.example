# Copy to .env. Never commit real credentials.
CRBOT_ADMIN_USERNAME=admin
CRBOT_ADMIN_PASSWORD=change-this-admin-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CRBOT_ENC_KEY=replace-with-your-random-encryption-secret
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=replace-with-your-random-webhook-secret
# OpenAI-compatible base URL, including /v1 when required.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Independent embedding service; blank URL reuses chat URL.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Opt-in synthetic reports, no external service required.
CRBOT_DEMO_ENABLED=false
